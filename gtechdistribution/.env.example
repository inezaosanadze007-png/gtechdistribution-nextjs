# Contact form email delivery (src/app/api/contact/route.ts)
#
# Copy to .env.local for local development, and set the same variables in your
# host's environment (Vercel: Project Settings -> Environment Variables), then
# redeploy. Without RESEND_API_KEY the form shows an error instead of silently
# pretending the request was delivered.
#
# Quote requests are sent with https://resend.com. To set it up:
#   1. Create an account at resend.com.
#   2. Add the domain mygeotech.online and add the DNS records it gives you
#      (DNS for this domain is managed at Wix).
#   3. Once the domain shows as verified, create an API key and put it below.
#
# Resend requires a verified domain, which is also why mail is sent from the
# site's own domain rather than a shared sender. It is not optional.
#
# These stay server-side — do NOT rename them with a NEXT_PUBLIC_ prefix, which
# would publish the API key in the browser bundle.

RESEND_API_KEY=

# Optional. Defaults are in src/app/api/contact/route.ts.
# QUOTE_FROM_EMAIL must be on the domain verified in Resend.
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=
