# Contact form email delivery (src/app/api/contact/route.ts)
#
# Copy to .env.local for local development, and set the same variables in your
# host's environment (Vercel: Project Settings -> Environment Variables).
# Without RESEND_API_KEY and CONTACT_FROM_EMAIL the form returns an error
# instead of silently pretending the request was delivered.

# API key from https://resend.com (Dashboard -> API Keys)
RESEND_API_KEY=

# Sender address. The domain must be verified in Resend before it will send.
# Free-mail addresses (outlook.com, gmail.com, ...) cannot be used as the sender.
CONTACT_FROM_EMAIL="GTechDistribution <quotes@gtechdistribution.com>"

# Where quote requests are delivered. Optional — defaults to the address below.
CONTACT_TO_EMAIL=Gtech.distribution@outlook.com
