# Contact form email delivery (src/app/api/contact/route.ts)
#
# Copy to .env.local for local development, and set the same variables in your
# host's environment (Vercel: Project Settings -> Environment Variables), then
# redeploy. Without BREVO_API_KEY the form shows an error instead of silently
# pretending the request was delivered.
#
# Quote requests are sent with https://brevo.com. To set it up:
#   1. Create an account at brevo.com.
#   2. Senders, Domains & Dedicated IPs -> Domains -> add mygeotech.online,
#      then add the TXT/CNAME records it gives you in the Wix DNS panel.
#   3. SMTP & API -> API Keys -> create a key and put it below.
#
# Brevo authenticates with TXT/CNAME records only. That matters: this domain's
# DNS is managed by Wix, which cannot publish MX records for subdomains, so
# providers that require one (Resend among them) cannot be used here unless the
# domain is moved off Wix.
#
# These stay server-side — do NOT rename them with a NEXT_PUBLIC_ prefix, which
# would publish the API key in the browser bundle.

BREVO_API_KEY=

# Optional. Defaults are in src/app/api/contact/route.ts.
# QUOTE_FROM_EMAIL must be on the domain authenticated in Brevo.
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=
